# Build from backend/: docker build -f keycloak-profile-sync/Dockerfile.reconciler -t de013/ecommerce-keycloak-reconciler:latest .
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build
COPY keycloak-profile-sync/pom.xml ./pom.xml
COPY keycloak-profile-sync/src ./src
RUN mvn -B -Preconciler clean package -DskipTests

FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/target/keycloak-profile-sync-*.jar /app/keycloak-profile-sync.jar
COPY --from=builder /build/target/reconciler-lib/ /app/lib/
USER 10001:10001
ENTRYPOINT ["java", "-cp", "/app/keycloak-profile-sync.jar:/app/lib/*", "org.de013.keycloak.profilesync.reconciliation.ProfileReconciliationRunner"]
